+## ---- Lab 6 Task 1.2: page-size-aware L2 TLB replacement ---- ##
+# Policy implemented in common/core/memory_subsystem/cache/cache_set_tlb_template.cc
+# (SRRIP where 2MB entries insert closer to "keep", age at 1/huge_aging_period speed,
+#  and lose protection once a set holds > max_huge_ways 2MB entries).
+[perf_model/mmu/tlb_level_2/tlb1]
+replacement_policy = "tlb_template"   # per-TLB key added in tlb.cc; default is "lru"
+
+[perf_model/mmu/tlb_level_2/tlb1/psa]
+bits = 2                # RRPV width (0 = keep ... 3 = evict)
+insert_4k = 2           # 4KB entries: SRRIP "long" insertion
+insert_2m = 0           # 2MB entries: inserted as if just re-referenced
+huge_aging_period = 2   # 2MB entries age every 2nd aging round
+max_huge_ways = 6       # of 8 ways; above this, 2MB entries are unprotected
+
+# ~50/50 mix of 4KB and 2MB pages for randacc_8gb (2048 2MB regions = 4GB of the 8GB footprint)
+[perf_model/reserve_thp_allocator]
+target_fragmentation = 0.25
