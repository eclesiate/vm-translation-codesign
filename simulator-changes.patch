+# = page-size-aware L2 TLB (virtuoso_tlb_replacement.cfg) + PTE-aware LLC replacement.
+#include ./virtuoso_configs/virtuoso_tlb_replacement.cfg
+
+## ---- PTE-aware LLC (NUCA) replacement ---- ##
+# Policy implemented in common/core/memory_subsystem/cache/cache_set_llc_template.cc,
+# Bloom filter in cache/pte_priority_hint.cc (fed by L2 TLB evictions in mmu.cc).
+[perf_model/nuca]
+replacement_policy = "llc_template"
+
+[perf_model/nuca/cache/llc_pte]
+bits = 2
+insert_data = 2         # data: identical to the baseline SRRIP LLC
+insert_pte = 1          # PTE line fetched by an ordinary walk
+insert_pte_hint = 0     # PTE line fetched by a walk whose VPN hit the Bloom filter
+pte_hit_age = 0         # PTE hit -> most protected
+max_pte_ways = 8        # of 16 ways; data always keeps >= 8 ways per set
+
+[perf_model/pte_bloom]
+bits = 65536            # per bank, 2 banks -> 16 KB
+hashes = 2
+epoch = 4096            # L2 TLB evictions per bank before rotation
